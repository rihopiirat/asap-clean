---
// Simplified launch version — sourced from the approved A.S.A.P. Clean
// business cards. No hero photo, no multi-step "how it works" section, no
// placeholder contact copy: services, service area and contact links are
// final, from the cards.
import "../styles/global.css";
import { copy, languageLinks, alternateLanguages, business, type Locale } from "../content/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const metaTitle = `${business.name} | ${t.eyebrow}`;
---
<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{metaTitle}</title>
		<meta name="description" content={t.intro} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow" />
		<link rel="shortcut icon" href="/favicon.svg" />
		<link rel="icon" href="/favicon.svg" />
		{Object.entries(alternateLanguages).map(([hreflang, href]) => (
			<link rel="alternate" hreflang={hreflang} href={href} />
		))}
	</head>
	<body>
		<main>
			<header class="site-header">
				<a class="brand" href="#top" aria-label={business.name}>
					<img class="brand-logo" src="/asap-clean-logo.png" alt={business.name} width="228" height="58" />
				</a>
				<nav class="desktop-nav" aria-label="Primary navigation">
					<a href="#services">{t.nav[0]}</a><a href="#area">{t.nav[1]}</a><a href="#review">{t.nav[2]}</a><a href="#contact">{t.nav[3]}</a>
				</nav>
				<div class="language-switch" aria-label="Language">
					{languageLinks.map((link) => (
						<a href={link.href} aria-current={link.label.toLowerCase() === locale ? "page" : undefined}>{link.label}</a>
					))}
				</div>
			</header>

			<section class="hero" id="top">
				<p class="eyebrow">{t.eyebrow}</p>
				<h1>{t.title}</h1>
				<p class="hero-intro">{t.intro}</p>
				<div class="hero-actions">
					<a class="button primary" href="#contact">{t.cta}</a>
					<a class="button secondary" href="#services">{t.secondary}</a>
				</div>
			</section>

			<section class="section services" id="services">
				<h2>{t.servicesTitle}</h2>
				<ul class="service-list">
					{t.services.map((service) => <li>{service}</li>)}
				</ul>
			</section>

			<section class="section area" id="area">
				<h2>{t.areaTitle}</h2>
				<p class="lead">{t.area}</p>
			</section>

			<section class="section review" id="review">
				<h2>{t.reviewTitle}</h2>
				<blockquote>“{t.review}”</blockquote>
				<p class="review-by">{t.reviewBy}</p>
			</section>

			<section class="contact" id="contact">
				<div class="contact-copy">
					<h2>{t.contactTitle}</h2>
					<p>{t.contact}</p>
					<p class="phone-number">{business.phoneDisplay}</p>
				</div>
				<div class="contact-actions">
					<a class="button primary" href={business.telHref}>{t.callLabel}</a>
					<a class="button whatsapp" href={business.waHref} target="_blank" rel="noopener noreferrer">{t.chatLabel}</a>
				</div>
			</section>

			<footer>
				<span class="brand compact">{business.name}</span>
				<p>{t.footer}</p>
				<p>© 2026</p>
			</footer>
		</main>
	</body>
</html>
